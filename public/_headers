# Cloudflare Pages headers.
# The pages.dev address and its preview deployments serve the same build as wwisermind.com.
# Keep them out of search results so only the real domain is indexed. wwisermind.com itself
# gets no noindex.
https://wwisermind.pages.dev/*
  X-Robots-Tag: noindex

https://:version.wwisermind.pages.dev/*
  X-Robots-Tag: noindex

# The help now widget and its data are loaded by therapists' own websites, so they allow any
# origin to read them. One hour of caching keeps updates reaching sites within the hour.
/data/crisis-resources.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/widget/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
