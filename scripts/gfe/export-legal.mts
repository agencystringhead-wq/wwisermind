/* Writes docs/gfe-legal-wording.md from lib/gfe/legal.ts, so the file a lawyer reads is always the wording the PDF prints. Run: npm run gfe:legal */
import { mkdirSync, writeFileSync } from 'node:fs';
import * as L from '../../lib/gfe/legal.ts';

const out = `# Good Faith Estimate: exact legal wording used in the PDF

Generated from \`lib/gfe/legal.ts\` by \`npm run gfe:legal\`. Do not edit this file by hand; change the wording in \`lib/gfe/legal.ts\` and run the script again.

## Source

The disclaimer is copied word for word from the CMS standard form **"Good Faith Estimate for Health Care Items and Services"** (Appendix 2, OMB Control Number 0938-1433, expiration 11/2025), the page headed "Disclaimer". Form: https://www.cms.gov/files/document/good-faith-estimate-example.pdf

Points for the reviewer:

- The $25 dispute fee, the 120 calendar day window and the $400 threshold are as printed on that CMS form. Please confirm they are still current.
- The CMS form's "Health Care Items/Services Expected to Be Separately Scheduled" section is included, with our own sentence saying there are none.
- The "valid for 12 months" sentence is printed only when a service has more than one session (the CMS form says to include it for recurring services).
- The tool collects an optional patient address, phone and email (printed on the PDF only when filled in, and never sent to the server). It does not collect the account number or contact preference that the CMS form also has.
- The tool assumes one provider per estimate (no co-provider or facility sections).

## Title

${L.GFE_TITLE}

## Self-pay line (our wording, under the title)

${L.SELF_PAY_NOTE}

## Lead-in to the itemized list (CMS wording, with the first service and first session date filled in)

${L.DETAIL_INTRO('[primary service]', '[date of first session]')}

## Valid-for-12-months sentence (CMS wording, printed only for recurring services)

${L.VALID_12_MONTHS}

## ${L.SEPARATE_PROVIDERS_HEADING}

${L.SEPARATE_PROVIDERS_NOTE}

## ${L.DISCLAIMER_HEADING} (CMS wording, word for word; bold paragraphs are bold in the PDF)

${L.DISCLAIMER.map((p) => (p.bold ? `**${p.text}**` : p.text)).join('\n\n')}

## Our own lines

- Layout note, small print at the end: ${L.OFFICIAL_FORM_NOTE}
- Footer on every page: ${L.FOOTER_LINE}
`;

mkdirSync(new URL('../../docs/', import.meta.url), { recursive: true });
writeFileSync(new URL('../../docs/gfe-legal-wording.md', import.meta.url), out);
console.log('wrote docs/gfe-legal-wording.md');
