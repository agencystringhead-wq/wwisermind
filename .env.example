# website scorecard. Copy to .dev.vars for local `wrangler pages dev`, and set the same names in the
# Cloudflare Pages dashboard (Settings > Variables and Secrets) for production and preview.
# Never commit real values.

# Google PageSpeed Insights API key (Google Cloud Console > APIs > PageSpeed Insights API).
PSI_API_KEY=

# Resend API key (resend.com). The sending domain must be verified in Resend.
RESEND_API_KEY=

# Cloudflare Turnstile secret key (server side). For local testing, Cloudflare's always-pass test
# secret is 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET_KEY=

# Local Map Assessment (shares RESEND_API_KEY, TURNSTILE_SECRET_KEY and the D1 binding DB with the scorecard).
# DataForSEO API login and password (app.dataforseo.com > API Access). Server side only, never in client code.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional. Defaults are in the code.
# LEAD_NOTIFY_EMAIL=admin@wwisermind.com
# RESEND_FROM=wwisermind <scorecard@wwisermind.com>
# SITE_ORIGIN=https://wwisermind.com

# Used at BUILD time (public, not secret). Put these in .env.local and in the Pages build variables.
# Turnstile site key. Local test site key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# The local map tool now exists: set this to /local-map-assessment/ so scorecard reports for practices with an office point to it.
NEXT_PUBLIC_LOCAL_MAP_TOOL_URL=
# Only for `npm run localmap:dev` (a local stand-in backend): point `next dev` at it. Leave unset in production.
# NEXT_PUBLIC_LOCAL_MAP_API=http://localhost:8788
